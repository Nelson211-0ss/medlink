# ============================================================
# MediLink — Root environment (used by docker-compose)
# Copy to .env and adjust as needed.
# ============================================================

# --- General ---
NODE_ENV=development
TZ=America/New_York

# --- Postgres ---
POSTGRES_USER=medilink
POSTGRES_PASSWORD=medilink_secret
POSTGRES_DB=medilink
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Elasticsearch ---
ELASTIC_PORT=9200

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=medilink

# --- MailHog ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- Backend ---
BACKEND_PORT=4000

# --- Frontend ---
FRONTEND_PORT=5173

# --- Nginx ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
