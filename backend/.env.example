# ============================================================
# MediLink Backend — environment
# Copy to .env
# ============================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost

# --- Database ---
# When running locally (not docker), host=localhost. In docker, host=postgres.
DATABASE_URL=postgresql://medilink:medilink_secret@localhost:5432/medilink
DB_HOST=localhost
DB_PORT=5432
DB_USER=medilink
DB_PASSWORD=medilink_secret
DB_NAME=medilink
DB_POOL_MAX=10

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Elasticsearch ---
ELASTICSEARCH_NODE=http://localhost:9200

# --- MinIO / S3 ---
STORAGE_DRIVER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=medilink
# Production S3:
AWS_REGION=us-east-1
AWS_S3_BUCKET=medilink

# --- Mail (MailHog in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="MediLink <no-reply@medilink.health>"

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PREMIUM_PRO=price_xxx
STRIPE_PRICE_PREMIUM_ORG=price_xxx

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
